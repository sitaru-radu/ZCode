{
  "name": "@zcode/dsh-executor",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness executor adapter over ACP (agent session client). Engine-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "oxlint . --ignore-pattern dist",
    "lint:fix": "oxlint --fix . --ignore-pattern dist",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  }
}
