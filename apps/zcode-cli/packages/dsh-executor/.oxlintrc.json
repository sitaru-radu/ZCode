{
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx", "tests/**/*.ts"],
      "rules": { "max-lines": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
